# Copy to .env.local (git-ignored) and fill in. EXPO_PUBLIC_ values are bundled into the app,
# so only put public values here. The publishable key is public; the secret key is NOT.
# For the local database, `npx supabase status` prints both values.
EXPO_PUBLIC_SUPABASE_US_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_US_PUBLISHABLE_KEY=
